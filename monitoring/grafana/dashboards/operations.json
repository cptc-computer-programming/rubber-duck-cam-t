{
  "uid": "rubber-duck-operations",
  "title": "Rubber Duck \u2014 Operations",
  "description": "Application reachability, HTTP errors, response startup latency, and request volume. Gaps mean missing measurements. Collector may retain exported app metrics for up to five minutes after export stops.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Application reachable",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Checks /health inside Docker every 15 seconds. Does not test model inference or external browser access.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"open-webui-health\"} and on(job,instance) (up{job=\"open-webui-health\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Metrics collection",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Whether Prometheus can scrape the Collector. This does not prove Open WebUI is exporting fresh metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"open-webui\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Total requests",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Estimated requests in the selected time range, excluding /health. Includes UI and API requests, not just chats.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_requests_total{job=\"open-webui\",http_route!=\"/health\"}[$__range])) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "HTTP errors",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "description": "Percentage of non-health requests returning HTTP 4xx or 5xx. No traffic or unavailable measurements show No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(rate(http_server_requests_total{job=\"open-webui\",http_route!=\"/health\",http_status_code=~\"[45]..\"}[$__rate_interval])) or (sum(rate(http_server_requests_total{job=\"open-webui\",http_route!=\"/health\"}[$__rate_interval])) * 0)) / sum(rate(http_server_requests_total{job=\"open-webui\",http_route!=\"/health\"}[$__rate_interval]))) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "HTTP 4xx + 5xx",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP response startup time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "description": "Time until the HTTP response starts, not until a streamed AI answer finishes. Histogram estimates; excludes /health. p95 means approximately 95% of requests are faster.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_duration_milliseconds_bucket{job=\"open-webui\",http_route!=\"/health\"}[$__rate_interval]))) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "Median",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{job=\"open-webui\",http_route!=\"/health\"}[$__rate_interval]))) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Requests per minute",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "description": "Average request rate scaled to one minute, excluding /health. Includes UI and API traffic, not just chats.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(http_server_requests_total{job=\"open-webui\",http_route!=\"/health\"}[$__rate_interval])) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "Requests/min",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Chat requests per minute",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "description": "POSTs to the two chat-completion API routes, including rejected requests. One request can start answers from several models; excludes page loads and background UI requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(http_server_requests_total{job=\"open-webui\",http_method=\"POST\",http_route=~\"/api/(v1/)?chat/completions\"}[$__rate_interval])) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "Chat requests/min",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Failed chat requests",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "description": "Failures per minute. HTTP failures include 4xx and 5xx. Processing failures include background preparation and response-stream errors; the series may overlap and must not be summed. Client cancellations are excluded from processing failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * (sum(rate(http_server_requests_total{job=\"open-webui\",http_method=\"POST\",http_route=~\"/api/(v1/)?chat/completions\",http_status_code=~\"[45]..\"}[$__rate_interval])) or (sum(rate(http_server_requests_total{job=\"open-webui\",http_method=\"POST\",http_route=~\"/api/(v1/)?chat/completions\"}[$__rate_interval])) * 0)) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "HTTP 4xx/5xx per min",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "60 * sum(rate(webui_chat_failures_total{job=\"open-webui\"}[$__rate_interval])) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "Processing/stream failures per min",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Time to first token",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "description": "Request arrival to first text chunk observed by the backend, including preparation and model loading. Excludes role-only, reasoning-only, and tool-call chunks. Streaming answers only; not network/browser rendering time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(webui_chat_time_to_first_token_seconds_bucket{job=\"open-webui\"}[$__rate_interval]))) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "Median",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(webui_chat_time_to_first_token_seconds_bucket{job=\"open-webui\"}[$__rate_interval]))) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Full answer duration",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "description": "Request arrival to successful answer completion. UI chats include tool continuations, but exclude later title/tag generation. Cancelled and failed answers are excluded. One observation per model answer; non-streamed answers included.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(webui_chat_answer_duration_seconds_bucket{job=\"open-webui\"}[$__rate_interval]))) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "Median",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(webui_chat_answer_duration_seconds_bucket{job=\"open-webui\"}[$__rate_interval]))) and on() (up{job=\"open-webui\"} == 1)",
          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
