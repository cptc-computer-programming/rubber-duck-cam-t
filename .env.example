# Keep loopback binding until the first administrator account is created.
# For campus access, change to the server's campus IP or 0.0.0.0.
WEBUI_BIND_ADDRESS=127.0.0.1
WEBUI_PORT=3000

# Generate with: openssl rand -hex 32
# Keep this key stable and include .env in protected backups.
WEBUI_SECRET_KEY=
